/dts-v1/;
/ {
    description = "RustSBI and official U-Boot, MUSE-Card USB RAM boot";
    #address-cells = <2>;
    images {
        opensbi {
            description = "RustSBI";
            data = /incbin/("rustsbi.bin");
            type = "firmware";
            os = "opensbi";
            arch = "riscv";
            compression = "none";
            load = <0 0x10000>;
            entry = <0 0x10000>;
            hash-1 { algo = "crc32"; };
        };
        uboot {
            description = "Official K1 U-Boot";
            data = /incbin/("u-boot-nodtb.bin");
            type = "standalone";
            os = "U-Boot";
            arch = "riscv";
            compression = "none";
            load = <0 0x00200000>;
            entry = <0 0x00200000>;
            hash-1 { algo = "crc32"; };
        };
        fdt {
            description = "k1-x_MUSE-Card";
            data = /incbin/("u-boot-muse-card.dtb");
            type = "flat_dt";
            compression = "none";
            load = <0 0x01000000>;
            hash-1 { algo = "crc32"; };
        };
    };
    configurations {
        default = "conf_muse_card";
        conf_muse_card {
            description = "k1-x_MUSE-Card";
            firmware = "opensbi";
            loadables = "uboot";
            fdt = "fdt";
        };
    };
};
