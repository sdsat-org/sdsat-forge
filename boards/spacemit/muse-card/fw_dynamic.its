/dts-v1/;
/ {
    description = "RustSBI dynamic firmware";
    #address-cells = <2>;
    images {
        opensbi {
            description = "RustSBI";
            data = /incbin/("rustsbi.bin");
            type = "firmware";
            arch = "riscv";
            os = "opensbi";
            compression = "none";
            load = <0x0 0x10000>;
            entry = <0x0 0x10000>;
            hash-1 { algo = "crc32"; };
        };
    };
    configurations {
        default = "config_1";
        config_1 {
            description = "MUSE-Card RustSBI";
            firmware = "opensbi";
        };
    };
};
