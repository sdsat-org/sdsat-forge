+func WithDisabledCgroups(_ context.Context, _ oci.Client, _ *containers.Container, s *runtimespec.Spec) error {
+	if s.Linux != nil {
+		s.Linux.CgroupsPath = ""
+		s.Linux.Resources = nil
+	}
+	return nil
+}
