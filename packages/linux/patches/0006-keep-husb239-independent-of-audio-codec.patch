Subject: [PATCH] usb: typec: keep HUSB239 independent of the audio codec

The optional Type-C headset notifier is provided by the ES8326 codec.
Only call it when that codec is reachable, so HUSB239 can remain built in
for USB power and data roles with sound disabled or the codec modular.
Keep accessory detection and the existing USB role handling unchanged.

--- a/drivers/usb/typec/husb239.c
+++ b/drivers/usb/typec/husb239.c
@@ -596,7 +596,9 @@
 		return ret;
 
 	if (husb239_get_accessory(husb239) == TYPEC_ACCESSORY_AUDIO) {
-		spacemit_headphone_notifier_call_chain(HEADSET_EVENT_CONNECTED, "typec");
+		if (IS_REACHABLE(CONFIG_SND_SOC_ES8326))
+			spacemit_headphone_notifier_call_chain(HEADSET_EVENT_CONNECTED,
+							     "typec");
 		/* sel = 0 audp/audn, sel = 1 hdp/hdn */
 		if (husb239->aud_gpiod) {
 			gpiod_set_value(husb239->aud_gpiod, 1);
@@ -657,7 +659,9 @@
 	husb239_set_data_role(husb239, HUSB239_DATA_ROLE(status1), false);
 
 	if (husb239->audio_online) {
-		spacemit_headphone_notifier_call_chain(HEADSET_EVENT_DISCONNECTED, "typec");
+		if (IS_REACHABLE(CONFIG_SND_SOC_ES8326))
+			spacemit_headphone_notifier_call_chain(HEADSET_EVENT_DISCONNECTED,
+							     "typec");
 		gpiod_set_value(husb239->aud_gpiod, 0);
 		gpiod_set_value(husb239->mic_gpiod, 0);
 		husb239->audio_online = false;
