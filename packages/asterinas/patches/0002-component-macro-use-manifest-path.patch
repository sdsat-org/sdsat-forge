Subject: [PATCH] component: use manifest directories for component identities

Component identities must be independent of how rustc spells source paths.
Workspace builds use relative file!() paths while external path dependencies
can use absolute paths. Trimming src/ or tests/ from those strings cannot
reliably match the absolute package directories returned by Cargo metadata.

Have init_component register the caller's CARGO_MANIFEST_DIR and normalize
its separators directly at lookup. The pinned source creates registry
entries only through this macro, so no file-path callers need adaptation.

On the metadata side, use the parent of the native manifest_path instead
of treating a package ID URL as a filesystem path. This also avoids the
Windows /D:/ drive-prefix mismatch and leaves URL escaping to Cargo.

The modified upstream files retain their MPL-2.0 license.

---
diff --git a/kernel/libs/comp-sys/component-macro/src/priority.rs b/kernel/libs/comp-sys/component-macro/src/priority.rs
--- a/kernel/libs/comp-sys/component-macro/src/priority.rs
+++ b/kernel/libs/comp-sys/component-macro/src/priority.rs
@@ -76,27 +76,15 @@
     // priority calculation complete
     let mut components_info = Vec::new();
     for package in component_packages {
-        let path = {
-            // Parse the package ID <https://doc.rust-lang.org/cargo/reference/pkgid-spec.html>
-            // and extract the path. Let's take `path+file:///path/to/comps/pci#aster-pci@0.1.0`
-            // as an example package ID.
-            let id = package["id"].as_str().unwrap();
-            // Remove the prefix `path+file://`.
-            assert!(id.starts_with("path+file://"));
-            let id = id.trim_start_matches("path+file://");
-            // Remove the fragment part `#aster-pci@0.1.0`. Note that the package name part
-            // may be missing if the directory name is the same as the package name.
-            id.split(['#', '@']).next().unwrap()
-        };
+        // Cargo already provides a native filesystem path. Package IDs are
+        // URLs, whose drive prefixes and escaping are not filesystem syntax.
+        let manifest = PathBuf::from(package["manifest_path"].as_str().unwrap());
+        let path = manifest.parent().unwrap().to_str().unwrap().replace('\\', "/");
         let component_info = {
             let package_name = package["name"].as_str().unwrap().to_string();
             ComponentInfo {
                 name: package_name.clone(),
-                path: PathBuf::from(&workspace_root)
-                    .join(path)
-                    .to_str()
-                    .unwrap()
-                    .to_string(),
+                path,
                 priority: *mapping.get(&package_name).unwrap(),
             }
         };
diff --git a/kernel/libs/comp-sys/component-macro/src/lib.rs b/kernel/libs/comp-sys/component-macro/src/lib.rs
index 012c0b3..0eca3cc 100644
--- a/kernel/libs/comp-sys/component-macro/src/lib.rs
+++ b/kernel/libs/comp-sys/component-macro/src/lib.rs
@@ -35,7 +35,7 @@ pub(crate) const COMPONENT_FILE_NAME: &str = "Components.toml";
 ///     Ok(())
 /// }
 ///
-/// component::submit!(component::ComponentRegistry::new(component::InitStage::Bootstrap, &init, file!()));
+/// component::submit!(component::ComponentRegistry::new(component::InitStage::Bootstrap, &init, env!("CARGO_MANIFEST_DIR")));
 /// ```
 /// The priority will calculate automatically
 ///
@@ -55,7 +55,7 @@ pub fn init_component(args: TokenStream, input: TokenStream) -> proc_macro::Toke
         component::submit!(component::ComponentRegistry::new(
             component::InitStage::#stage,
             &#function_name,
-            file!())
+            env!("CARGO_MANIFEST_DIR"))
         );
     }
     .into()
diff --git a/kernel/libs/comp-sys/component/src/lib.rs b/kernel/libs/comp-sys/component/src/lib.rs
index a97dc47..6419e66 100644
--- a/kernel/libs/comp-sys/component/src/lib.rs
+++ b/kernel/libs/comp-sys/component/src/lib.rs
@@ -9,7 +9,6 @@
 extern crate alloc;

 use alloc::{
-    borrow::ToOwned,
     collections::BTreeMap,
     fmt::Debug,
     string::{String, ToString},
@@ -164,7 +163,7 @@ fn parse_input(components: Vec<ComponentInfo>) -> BTreeMap<String, ComponentInfo
     out
 }

-/// Match the ComponentInfo with ComponentRegistry. The key is the relative path of one component
+/// Match component metadata and registrations by their absolute manifest directory.
 fn match_and_call(
     stage: InitStage,
     mut components: BTreeMap<String, ComponentInfo>,
@@ -175,29 +174,12 @@ fn match_and_call(
             continue;
         }

-        // relative/path/to/comps/pci/src/lib.rs
-        let mut str: String = registry.path.to_owned();
-        str = str.replace('\\', "/");
-        // relative/path/to/comps/pci
-        // There are two cases, one in the test folder and one in the src folder.
-        // There may be multiple directories within the folder.
-        // There we assume it will not have such directories: 'comp1/src/comp2/src/lib.rs' so that we can split by tests or src string
-        if str.contains("src/") {
-            str = str
-                .trim_end_matches(str.get(str.find("src/").unwrap()..str.len()).unwrap())
-                .to_string();
-        } else if str.contains("tests/") {
-            str = str
-                .trim_end_matches(str.get(str.find("tests/").unwrap()..str.len()).unwrap())
-                .to_string();
-        } else {
-            panic!("The path of {} cannot recognized by component system", str);
-        }
-        let str = str.trim_end_matches('/').to_owned();
+        // Match Cargo metadata regardless of how rustc spells source paths.
+        let path = registry.path.replace('\\', "/");

         let mut info = components
-            .remove(&str)
-            .ok_or(ComponentSystemInitError::NotIncludeAllComponent(str))?;
+            .remove(&path)
+            .ok_or(ComponentSystemInitError::NotIncludeAllComponent(path))?;
         info.function.replace(registry.function);
         infos.push(info);
     }
