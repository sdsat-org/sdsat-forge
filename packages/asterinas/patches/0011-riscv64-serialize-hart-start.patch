Subject: [PATCH] Serialize RISC-V hart startup with an online handshake

SBI hart_start is asynchronous. Wait for the requested hardware hart to
report online before starting the next one, as Linux does during CPU
bring-up. Bound the wait and report the hardware hart ID and SBI state on
failure. This avoids the MUSE-Card startup hang observed with concurrent
requests when INFO logging is disabled, without introducing fixed delays.

diff --git a/ostd/src/arch/riscv/boot/smp.rs b/ostd/src/arch/riscv/boot/smp.rs
index 50602e6..df4245e 100644
--- a/ostd/src/arch/riscv/boot/smp.rs
+++ b/ostd/src/arch/riscv/boot/smp.rs
@@ -100,15 +100,29 @@ unsafe fn bringup_ap(hart_id: u32) {
         /* Unused */ 0,
     );
 
-    if result.error == 0 {
-        crate::debug!("Successfully started hart {}", hart_id);
-    } else {
-        crate::error!(
-            "Failed to start hart {}: error code {}",
-            hart_id,
-            result.error
-        );
+    assert_eq!(
+        result.error, 0,
+        "SBI hart_start failed for hardware hart {}",
+        hart_id
+    );
+
+    // SBI success only means the asynchronous start request was accepted.
+    // Wait until this exact hardware hart has completed OSTD initialization
+    // before asking the firmware to start another hart.
+    let start = crate::arch::read_tsc();
+    let timeout_ticks = crate::arch::tsc_freq().saturating_mul(5);
+    while !crate::boot::smp::is_hart_started(hart_id) {
+        if crate::arch::read_tsc().wrapping_sub(start) >= timeout_ticks {
+            let status = sbi_rt::hart_get_status(hart_id as usize);
+            panic!(
+                "Timed out waiting for hardware hart {} to come online: SBI HSM error={}, state={}",
+                hart_id, status.error, status.value
+            );
+        }
+        core::hint::spin_loop();
     }
+
+    crate::debug!("Hardware hart {} is online", hart_id);
 }
 
