+/// Checks the hardware hart ID, rather than its arrival-order logical CPU ID.
+#[cfg(target_arch = "riscv64")]
+pub(crate) fn is_hart_started(hart_id: u32) -> bool {
+    HW_CPU_ID_MAP
+        .lock()
+        .values()
+        .any(|id| id.as_u32() == hart_id)
